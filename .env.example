# ---------------------------------------------------------------------------
# LeadHunter — variaveis de ambiente
# Copie este arquivo para `.env.local` e preencha com as suas credenciais.
# NUNCA versione o arquivo `.env.local`.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada apenas no servidor (nunca exposta ao browser).
# Opcional: a aplicacao funciona sem ela, pois todo acesso a dados passa pelo
# usuario autenticado + RLS. Reservada para tarefas administrativas futuras.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# ---------------------------------------------------------------------------
# Fontes de prospeccao (SPEC 1.2) — o modo gratuito (FREE) usa somente
# OpenStreetMap/Overpass e nao precisa de nenhuma variavel desta secao.
# ---------------------------------------------------------------------------

# Endpoint publico do Overpass (opcional — tem um padrao publico).
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# OVERPASS_TIMEOUT_MS=30000

# Endpoint publico do Nominatim, usado para geocodificar a cidade (opcional).
# NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search

# User-Agent exigido pela politica de uso do Nominatim (opcional).
# OSM_USER_AGENT=LeadHunter/1.2 (prospeccao comercial)

# Google Places — PAGO e DESATIVADO POR PADRAO. A simples presenca de
# GOOGLE_MAPS_API_KEY abaixo NAO autoriza nenhuma chamada nem gera cobranca:
# e preciso o opt-in explicito "true" aqui. Qualquer outro valor (ausente,
# "false", vazio) mantem o Google desligado, mesmo com a chave configurada.
GOOGLE_PLACES_ENABLED=false

# Foursquare — mesma regra do Google (pago, opt-in explicito). A integracao
# ainda nao existe: esta variavel so reserva o comportamento para quando ela
# for implementada; ligar isto hoje nao tem efeito nenhum.
FOURSQUARE_ENABLED=false

# Google Maps Platform — Places API (New) + Geocoding API habilitadas.
# Chave usada SOMENTE no servidor. Nao prefixar com NEXT_PUBLIC_.
# So e usada se GOOGLE_PLACES_ENABLED=true.
GOOGLE_MAPS_API_KEY=

# Regiao/idioma padrao das buscas no Google (opcional).
GOOGLE_PLACES_REGION_CODE=BR
GOOGLE_PLACES_LANGUAGE_CODE=pt-BR

# DDI padrao usado para normalizar telefones sem codigo de pais (opcional).
DEFAULT_PHONE_COUNTRY_CODE=55

# Dias antes de reconsultar a presenca digital de uma empresa ja conhecida.
# Controla custo de API. Padrao: 7.
DIGITAL_PRESENCE_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Descoberta de Instagram por mecanismo de busca — OPCIONAL
# Google Programmable Search JSON API (API oficial, cobrada por consulta).
# Sem estas duas variaveis o sistema so procura o perfil no site oficial da
# empresa; com elas, tambem encontra perfis de empresas que nao tem site.
# Consultada apenas quando o site nao resolve.
# ---------------------------------------------------------------------------
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=

# ---------------------------------------------------------------------------
# SPEC 2.0 — nucleo comercial.
#
# Tudo nesta secao e OPCIONAL e vem DESLIGADO. O LeadHunter continua funcionando
# sem nenhuma destas variaveis: sem IA o score deterministico e os templates
# seguem valendo (SPEC 2.0 §15.5), e sem provedor de e-mail a cadencia
# simplesmente nao e oferecida.
#
# Nenhuma chave secreta pode usar o prefixo NEXT_PUBLIC_ (SPEC 2.0 §31).
# ---------------------------------------------------------------------------

# --- Apify (fonte de descoberta, §8) ---------------------------------------
# Mesma regra de opt-in do Google Places: a presenca do token NAO autoriza gasto.
APIFY_ENABLED=false
APIFY_TOKEN=
# Legacy aliases used by the generic SPEC 2.0 reader; operational wiring uses APIFY_TOKEN.
APIFY_API_TOKEN=
APIFY_GOOGLE_MAPS_ACTOR_ID=
APIFY_TASK_ID=
# Use APIFY_ACTOR_ID only when no Task is configured.
# APIFY_ACTOR_ID=
APIFY_WEBHOOK_SECRET=
APIFY_MAX_RESULTS_PER_RUN=50
APIFY_MAX_COST_CENTS_PER_CAMPAIGN=2000
APP_BASE_URL=http://localhost:3000
# APIFY_DEFAULT_MEMORY_MB=1024
# APIFY_DEFAULT_TIMEOUT_SECONDS=300

# --- Provedor de e-mail (§17) ----------------------------------------------
# O provedor precisa aceitar o caso de uso, permitir autenticacao de dominio
# (SPF/DKIM/DMARC) e enviar webhooks de entrega, bounce e reclamacao.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Legacy provider alias used by the generic SPEC 2.0 reader.
EMAIL_API_KEY=
EMAIL_WEBHOOK_SECRET=
EMAIL_INBOUND_SECRET=
EMAIL_DEFAULT_FROM=
EMAIL_DEFAULT_REPLY_TO=
# Comece baixo e aumente devagar: volume subito queima a reputacao do dominio (§17.5).
EMAIL_DAILY_LIMIT=25
EMAIL_SENDING_ENABLED=false
EMAIL_DRY_RUN=true
POSTGRES_VALIDATED=false
EMAIL_DNS_VALIDATED=false

# --- IA (§15) ---------------------------------------------------------------
# A IA nunca decide envio, supressao ou venda — ela resume, sugere e classifica.
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Teto de custo de IA por campanha, em centavos.
AI_MAX_COST_PER_CAMPAIGN=

# --- Auditoria de presenca digital (§11) ------------------------------------
# Respeita robots.txt e limita paginas, tempo e bytes por dominio.
WEBSITE_AUDIT_ENABLED=true
WEBSITE_AUDIT_TIMEOUT_MS=15000
WEBSITE_AUDIT_MAX_PAGES=5
WEBSITE_AUDIT_MAX_BYTES=5000000

# --- Worker de jobs (§24) ---------------------------------------------------
# Segredo exigido para acionar o worker por HTTP. Apenas servidor.
JOB_WORKER_SECRET=
JOB_BATCH_SIZE=10
JOB_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# WhatsApp: nao ha variavel nenhuma, e isso e proposital (SPEC 2.0 §33.5).
# O LeadHunter abre uma conversa manual por wa.me e nada mais — nenhuma
# credencial de WhatsApp e necessaria porque nada e enviado pelo sistema.
# ---------------------------------------------------------------------------
